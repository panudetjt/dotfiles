#!/bin/sh
# mise bootstrap — zero-trust: โหลด binary เวอร์ชันที่ pin ตรงจาก GitHub Releases
# แล้วเทียบ sha256 กับ hash ที่จดใน install/mise-pinned.sha256 ก่อนติดตั้งเสมอ
# ไม่ผ่าน = หยุดทันที ห้ามติดตั้ง — ไม่มี curl|sh ในสายนี้ทั้งหมด
set -eu
if ! command -v mise >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/mise" ]; then
{{ if eq .chezmoi.os "darwin" }}
{{ if eq .chezmoi.arch "arm64" }}
    asset="mise-v2026.10.15-macos-arm64"
    expect="826c4833fa7437a63f6027b86bc10c8b61b1163dc793c03ecde92f68ad167890"
{{ else }}
    echo "mise pin ไม่มี darwin-amd64 (intel mac) — เพิ่ม hash ใน install/mise-pinned.sha256 ก่อน" >&2
    exit 1
{{ end }}
{{ else if eq .chezmoi.arch "amd64" }}
    asset="mise-v2026.10.15-linux-x64"
    expect="e3b186d4c70627f27037be615becaf4acfb30e41fb6a1819486717dc94e4e2a9"
{{ else if eq .chezmoi.arch "arm64" }}
    asset="mise-v2026.10.15-linux-arm64"
    expect="3abbaac305a465ef038eb4ea07b961c037a8b639108005e43f8e2c00a8f67c11"
{{ else }}
    echo "arch ไม่รองรับ: {{ .chezmoi.arch }}" >&2
    exit 1
{{ end }}
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL -o "$tmp/mise" "https://github.com/jdx/mise/releases/download/v2026.10.15/$asset"
{{ if eq .chezmoi.os "darwin" }}
    actual="$(shasum -a 256 "$tmp/mise" | cut -d' ' -f1)"
{{ else }}
    actual="$(sha256sum "$tmp/mise" | cut -d' ' -f1)"
{{ end }}
    if [ "$actual" != "$expect" ]; then
        echo "sha256 MISMATCH ($actual != $expect) — ไฟล์ไม่ตรงที่ pin ไว้ หยุดติดตั้ง" >&2
        exit 1
    fi
    mkdir -p "$HOME/.local/bin"
    install -m 0755 "$tmp/mise" "$HOME/.local/bin/mise"
    echo "mise installed (pinned + checksum verified): $($HOME/.local/bin/mise --version)"
fi
{{ if eq .chezmoi.os "darwin" -}}
# macOS: แพ็กเกจตาม Brewfile (brew = owner ติดตั้งเองตาม README — อยู่นอกห่วงโซ่ pin)
command -v brew >/dev/null 2>&1 && brew bundle --file={{ .chezmoi.sourceDir | quote }}/Brewfile
{{- end }}
