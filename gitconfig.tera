[user]
	name = {{ vars.name | quote }}
	email = {{ vars.email | quote }}
[init]
	defaultBranch = main
[core]
	editor = vim
{% if os() == "macos" %}
	pager = bat -p
{% endif %}
[credential]
	helper = store
	useHttpPath = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[url "https://github.com/"]
	insteadOf = git@github.com:
[credential "https://android.googlesource.com"]
	helper = 
	helper = luci
	useHttpPath = yes
[credential "https://aomedia.googlesource.com"]
	helper = 
	helper = luci
	useHttpPath = yes
